# ──────────────────────────────────────────────────────────────
# Copy this file to .env for local development
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# ── Twitter Auth ────────────────────────────────────────────────
# Option A (preferred): base64-encoded cookie string
# Printed to console on first successful login — copy it here
TWITTER_COOKIES=

# Option B: fresh login credentials (used when TWITTER_COOKIES is empty)
TWITTER_USERNAME=your_throwaway_account
TWITTER_PASSWORD=your_password
TWITTER_EMAIL=your_email@example.com

# ── API Protection ──────────────────────────────────────────────
# Any random secret. Leave blank for open access (local dev only).
# Generate one: openssl rand -hex 32
API_SECRET=
